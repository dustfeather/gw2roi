{
  "name": "gw2roi",
  "version": "1.0.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "warn"
    }
  },
  "type": "module",
  "description": "Ranks top-N craftable GW2 items by profit. Hourly Cloudflare Cron Trigger, D1, SSR board.",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply gw2 --remote",
    "seed-cache": "bun run scripts/seed-cache.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@gw2/core": "workspace:*",
    "@types/node": "^26.6.2",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.0",
    "wrangler": "^4.136.1"
  }
}
